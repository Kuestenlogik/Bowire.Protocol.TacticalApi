<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1515: the in-process server fixture is injected into public xUnit test classes and must be public.
         CA1056: its addresses go to the plugin's string-typed serverUrl API.
         CA1812: the stub gRPC services are created by MapGrpcService<T>(). -->
    <NoWarn>$(NoWarn);CA1515;CA1056;CA1812</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Kuestenlogik.Bowire" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.AspNetCore" />
    <!-- gRPC-Web on the fixture's HTTP/1.1 listener, so the plugin's
         useGrpcWeb path is proven against a port that speaks nothing
         else (#67). -->
    <PackageReference Include="Grpc.AspNetCore.Web" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Kuestenlogik.Bowire.Protocol.TacticalApi\Kuestenlogik.Bowire.Protocol.TacticalApi.csproj" />
  </ItemGroup>
</Project>
