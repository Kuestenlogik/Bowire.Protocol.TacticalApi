<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Sdk.Web so the fixture can host the sample's gRPC services on a
         real in-process Kestrel. -->
    <NoWarn>$(NoWarn);CA1812;CA1515;CA1056</NoWarn>
    <!-- The sample carries the embedded workbench's static web assets;
         this project serves gRPC only, and letting the assets flow in
         made the SDK's precompressed-asset discovery see them twice. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
  <ItemGroup>
    <!-- The sample, not the plugin: these tests pin what the sample README
         promises, driven through the plugin the sample already references.
         The plugin's own suite stays free of the sample and everything it
         brings along. -->
    <ProjectReference Include="..\..\samples\Kuestenlogik.Bowire.Protocol.TacticalApi.Sample\Kuestenlogik.Bowire.Protocol.TacticalApi.Sample.csproj" />
  </ItemGroup>
</Project>
